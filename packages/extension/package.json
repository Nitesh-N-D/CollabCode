{
  "name": "collabcode-vscode",
  "displayName": "CollabCode Classroom",
  "description": "Real-time classroom coding support for students.",
  "version": "1.1.0",
  "publisher": "niteshnd",
  "icon": "images/icon.png",
  "repository": {
  "type": "git",
  "url": "https://github.com/Nitesh-N-D/CollabCode"
  },
  "homepage": "https://collabcode-dashboard.vercel.app",
  "bugs": {
  "url": "https://github.com/Nitesh-N-D/CollabCode/issues"
  },
  "license": "MIT",
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Education", "Other"],
   "keywords": [
    "education",
    "classroom",
    "coding",
    "teacher",
    "student",
    "programming",
    "collaboration",
    "socket.io",
    "ai",
    "learning"
  ],
  "galleryBanner": {
    "color": "#5B4BDB",
    "theme": "dark"
  },
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      { "command": "collabcode.joinRoom", "title": "CollabCode: Join Classroom" },
      { "command": "collabcode.leaveRoom", "title": "CollabCode: Leave Classroom" },
      { "command": "collabcode.requestHelp", "title": "CollabCode: Request Help Privately" },
      { "command": "collabcode.openCompanion", "title": "CollabCode: Open Session Companion" },
      { "command": "collabcode.showPrivacy", "title": "CollabCode: Show Data & Privacy" },
      { "command": "collabcode.exportSession", "title": "CollabCode: Export My Session" }
    ],
    "configuration": {
      "title": "CollabCode",
      "properties": {
        "collabcode.serverUrl": {
          "type": "string",
          "default": "https://collabcode-api-w9km.onrender.com",
          "description": "CollabCode server URL"
        },
        "collabcode.displayName": {
          "type": "string",
          "default": "",
          "description": "Name shown to the instructor"
        },
        "collabcode.snapshotIntervalMs": {
          "type": "number",
          "default": 2000,
          "minimum": 1000,
          "description": "How often active editor snapshots are sent"
        }
      }
    }
  },
  "scripts": {
    "dev": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --watch",
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --minify",
    "package": "pnpm build && vsce package --no-dependencies --allow-missing-repository",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"console.log('extension: build is the verification gate')\""
  },
  "dependencies": {
    "@collabcode/shared": "workspace:*",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.4.2",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  }
}
